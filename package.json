{
  "name": "unplugin-replace",
  "type": "module",
  "version": "0.9.1",
  "description": "A universal bundler plugin which replaces targeted strings in files.",
  "author": "Kevin Deng <sxzz@sxzz.moe>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/sxzz",
  "homepage": "https://github.com/unplugin/unplugin-replace#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unplugin/unplugin-replace.git"
  },
  "bugs": {
    "url": "https://github.com/unplugin/unplugin-replace/issues"
  },
  "keywords": [
    "unplugin",
    "rollup",
    "vite",
    "esbuild",
    "webpack"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./esbuild": "./dist/esbuild.mjs",
    "./farm": "./dist/farm.mjs",
    "./rolldown": "./dist/rolldown.mjs",
    "./rollup": "./dist/rollup.mjs",
    "./rspack": "./dist/rspack.mjs",
    "./vite": "./dist/vite.mjs",
    "./webpack": "./dist/webpack.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "scripts": {
    "lint": "eslint --cache .",
    "lint:fix": "pnpm run lint --fix",
    "format": "prettier --write .",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "js-tokens": "^10.0.0",
    "rolldown-string": "^0.3.1",
    "unplugin": "^3.4.0"
  },
  "devDependencies": {
    "@sxzz/eslint-config": "^8.7.0",
    "@sxzz/prettier-config": "^2.3.3",
    "@sxzz/test-utils": "^0.5.19",
    "@types/node": "^26.6.5",
    "@typescript/native-preview": "npm:typescript@~7.0.2",
    "bumpp": "^12.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "rolldown": "1.2.13",
    "rollup": "^4.64.5",
    "tsdown": "^0.23.1",
    "tsdown-preset-sxzz": "^0.7.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "webpack": "^5.111.1"
  },
  "prettier": "@sxzz/prettier-config"
}
