{
  "name": "unplugin-replace",
  "type": "module",
  "version": "0.9.0",
  "packageManager": "pnpm@11.17.0",
  "description": "A universal bundler plugin which replaces targeted strings in files.",
  "author": "Kevin Deng <sxzz@sxzz.moe>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/sxzz",
  "homepage": "https://github.com/unplugin/unplugin-replace#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unplugin/unplugin-replace.git"
  },
  "bugs": {
    "url": "https://github.com/unplugin/unplugin-replace/issues"
  },
  "keywords": [
    "unplugin",
    "rollup",
    "vite",
    "esbuild",
    "webpack"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./esbuild": "./dist/esbuild.mjs",
    "./farm": "./dist/farm.mjs",
    "./rolldown": "./dist/rolldown.mjs",
    "./rollup": "./dist/rollup.mjs",
    "./rspack": "./dist/rspack.mjs",
    "./vite": "./dist/vite.mjs",
    "./webpack": "./dist/webpack.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "scripts": {
    "lint": "eslint --cache .",
    "lint:fix": "pnpm run lint --fix",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsgo --noEmit",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "js-tokens": "^10.0.0",
    "rolldown-string": "^0.3.0",
    "unplugin": "^3.0.0"
  },
  "devDependencies": {
    "@sxzz/eslint-config": "^8.0.0",
    "@sxzz/prettier-config": "^2.3.1",
    "@sxzz/test-utils": "^0.5.18",
    "@types/node": "^25.6.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "bumpp": "^11.0.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "prettier": "^3.8.3",
    "rolldown": "1.2.0",
    "rollup": "^4.60.3",
    "tsdown": "^0.22.0",
    "tsdown-preset-sxzz": "^0.6.0",
    "typescript": "^7.0.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.5",
    "webpack": "^5.106.2"
  },
  "prettier": "@sxzz/prettier-config"
}
